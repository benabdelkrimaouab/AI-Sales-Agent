    {
      "parameters": {
        "jsCode": "const busy = $input.all().map(item => ({\n  start: item.json.start?.dateTime,\n  end: item.json.end?.dateTime\n})).filter(b => b.start && b.end).map(b => ({ start: DateTime.fromISO(b.start), end: DateTime.fromISO(b.end) }));\n\nconst slotMinutes = 30;\nconst businessStartHour = 9;\nconst businessEndHour = 17;\n\nfunction overlaps(slotStart, slotEnd) {\n  return busy.some(b => slotStart < b.end && slotEnd > b.start);\n}\n\nlet cursor = $now.plus({ days: 1 }).set({ hour: businessStartHour, minute: 0, second: 0, millisecond: 0 });\nconst deadline = $now.plus({ days: 10 });\nlet found = null;\n\nwhile (cursor < deadline) {\n  const weekday = cursor.weekday; // 1=Mon ... 7=Sun\n  if (weekday > 5) {\n    cursor = cursor.plus({ days: 1 }).set({ hour: businessStartHour, minute: 0 });\n    continue;\n  }\n  if (cursor.hour >= businessEndHour) {\n    cursor = cursor.plus({ days: 1 }).set({ hour: businessStartHour, minute: 0 });\n    continue;\n  }\n  const slotEnd = cursor.plus({ minutes: slotMinutes });\n  if (!overlaps(cursor, slotEnd)) {\n    found = { start: cursor.toISO(), end: slotEnd.toISO() };\n    break;\n  }\n  cursor = slotEnd;\n}\n\nif (!found) {\n  const fallbackStart = $now.plus({ days: 1 }).set({ hour: businessStartHour, minute: 0 });\n  found = { start: fallbackStart.toISO(), end: fallbackStart.plus({ minutes: slotMinutes }).toISO() };\n}\n\nreturn [{ json: found }];"
      },
