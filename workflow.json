    {
      "parameters": {
        "promptType": "define",
        "text": "=Lead details:\nName: {{ $json.name }}\nCompany: {{ $json.company }}\nBudget: {{ $json.budget }}\nMessage: {{ $json.message }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a B2B sales qualification analyst. Score the lead from 1-10 using this weighted rubric: (1) Budget clarity and size, 40% — a specific number/range scores higher than vague or missing budget, and larger budgets score higher than smaller ones; (2) Urgency signals in the message, 30% — explicit timeframes or pressure score higher; (3) Legitimacy and decision-maker tone, 30% — a named company and confident, authoritative language scores higher than a vague or hesitant tone. Weigh all three factors together — a small budget with strong urgency and legitimacy can still outscore a large budget with a weak, hesitant message. A lead is \"qualified\" (qualified: true) only if score >= 6. Always return a short, specific reason (max 20 words) referencing which factors drove the score, and one concrete suggested_next_step. Respond only in the required JSON format."
        }
      },
